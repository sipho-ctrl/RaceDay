@model RaceDayMVC.ViewModels.MyEventsViewModel
@{
    ViewData["Title"] = "My Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-bookmark-check"></i> My Events</h1>
        <p class="text-muted mb-0">Events you've registered for</p>
    </div>
    <div>
        <a asp-controller="Participant" asp-action="Index" class="btn btn-raceday">
            <i class="bi bi-plus-circle"></i> Find More Events
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Total Enrolments</p>
                <h3 class="mb-0">@Model.Enrolments.Count</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Paid</p>
                <h3 class="mb-0 text-success">@Model.ConfirmedCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Pending</p>
                <h3 class="mb-0 text-warning">@Model.PendingCount</h3>
            </div>
        </div>
    </div>
</div>

@if (Model.Enrolments.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-bookmark-x text-muted" style="font-size:4rem;"></i>
        <p class="mt-3 text-muted">You haven't enrolled in any events yet.</p>
        <a asp-controller="Participant" asp-action="Index" class="btn btn-raceday">
            <i class="bi bi-search"></i> Browse Events
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var e in Model.Enrolments)
        {
            var payClass = e.PaymentStatus == "Paid" ? "status-confirmed" : "status-pending";
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="status-badge @payClass">@e.PaymentStatus</span>
                            @if (e.StartNumber.HasValue)
                            {
                                <span class="badge bg-primary">Start #@e.StartNumber</span>
                            }
                        </div>
                        <h5 class="mb-1">@e.EventName</h5>
                        <p class="text-muted small mb-2">
                            <i class="bi bi-calendar-event"></i> @e.EventDate.ToString("dd MMM yyyy")
                        </p>
                        <p class="mb-0 small">
                            <strong>Category:</strong> @e.CategoryName (@e.CategoryDistance km)
                        </p>
                        <p class="text-muted small mb-0">
                            Enrolled: @e.RegistrationDate.ToString("dd MMM yyyy")
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}