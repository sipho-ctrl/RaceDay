@model RaceDayMVC.ViewModels.ParticipantHomeViewModel
@{
    ViewData["Title"] = "Browse Events";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-trophy"></i> Upcoming Events</h1>
        <p class="text-muted mb-0">Welcome, <strong>@Model.Username</strong> — browse and enter events</p>
    </div>
    <div>
        <span class="badge bg-primary fs-6">
            <i class="bi bi-check2-circle"></i> My Enrolments: @Model.MyEnrolmentCount
        </span>
    </div>
</div>

<!-- Filter bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-controller="Participant" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">Event Type</label>
                <select name="eventType" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    <option value="run" selected="@(Model.EventTypeFilter == "run")">Run</option>
                    <option value="walk" selected="@(Model.EventTypeFilter == "walk")">Walk</option>
                    <option value="cycle" selected="@(Model.EventTypeFilter == "cycle")">Cycle</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small">Location</label>
                <input type="text" name="location" value="@Model.LocationFilter" class="form-control form-control-sm" placeholder="e.g., Cape Town" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-raceday btn-sm">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                <a asp-controller="Participant" asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Events.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-calendar-x text-muted" style="font-size:4rem;"></i>
        <p class="mt-3 text-muted">No events match your filters.</p>
        <a asp-controller="Participant" asp-action="Index" class="btn btn-raceday">Show All Events</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var ev in Model.Events)
        {
            var typeIcon = ev.EventType switch
            {
                "run" => "bi-person-walking",
                "walk" => "bi-person-arms-up",
                "cycle" => "bi-bicycle",
                _ => "bi-flag"
            };

            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary">
                                <i class="bi @typeIcon"></i> @ev.EventType?.ToUpper()
                            </span>
                            <span class="status-badge status-open">@ev.EventStatus</span>
                        </div>
                        <h5 class="card-title mb-1">@ev.EventName</h5>
                        <p class="text-muted small mb-2">
                            <i class="bi bi-geo-alt"></i> @ev.Location
                        </p>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-calendar-event"></i> @ev.EventDate.ToString("dd MMM yyyy")
                            @if (!string.IsNullOrEmpty(ev.Distance))
                            {
                                <span> · @ev.Distance</span>
                            }
                        </p>
                        @if (!string.IsNullOrEmpty(ev.Description))
                        {
                            <p class="small text-truncate">@ev.Description</p>
                        }
                    </div>
                    <div class="card-footer bg-white border-top">
                        <a asp-controller="Participant" asp-action="EventDetail" asp-route-id="@ev.EventID" class="btn btn-raceday w-100">
                            View Details & Enrol <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}