@model RaceDayMVC.ViewModels.OrganiserDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-speedometer2"></i> Organiser Dashboard</h1>
        <p class="text-muted mb-0">Welcome back, <strong>@Model.OrganisationName</strong></p>
    </div>
    <div>
        <a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-raceday">
            <i class="bi bi-plus-circle"></i> Create New Event
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Total Events</p>
                        <h3 class="mb-0">@Model.TotalEvents</h3>
                    </div>
                    <i class="bi bi-calendar-event" style="font-size:2.5rem;color:var(--raceday-primary);"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Total Enrolments</p>
                        <h3 class="mb-0">@Model.TotalEnrolments</h3>
                    </div>
                    <i class="bi bi-people-fill" style="font-size:2.5rem;color:var(--raceday-accent);"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Upcoming Events</p>
                        <h3 class="mb-0">@Model.Events.Count(e => e.EventDate >= DateTime.Today)</h3>
                    </div>
                    <i class="bi bi-clock-history" style="font-size:2.5rem;color:#6c757d;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-list-ul"></i> My Events</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Events.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x text-muted" style="font-size:3rem;"></i>
                <p class="mt-3 text-muted">You haven't created any events yet.</p>
                <a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-raceday">
                    <i class="bi bi-plus-circle"></i> Create Your First Event
                </a>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Enrolments</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.Events.OrderBy(e => e.EventDate))
                    {
                        <tr>
                            <td><strong>@ev.EventName</strong></td>
                            <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@ev.Location</td>
                            <td>
                                <span class="badge bg-secondary">@ev.EnrolmentCount</span>
                            </td>
                            <td>
                                @{
                                    var statusClass = ev.EventStatus switch
                                    {
                                        "Open" => "status-open",
                                        "Closed" => "status-closed",
                                        "Cancelled" => "status-cancelled",
                                        _ => "status-pending"
                                    };
                                }
                                <span class="status-badge @statusClass">@ev.EventStatus</span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Organiser" asp-action="Enrolments" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-people"></i> Enrolments
                                </a>
                                <a asp-controller="Organiser" asp-action="EditEvent" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>