@model RaceDayMVC.ViewModels.CategoriesViewModel
@{
    ViewData["Title"] = "Manage Categories";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-tags"></i> Categories</h1>
        <p class="text-muted mb-0">
            <strong>@Model.EventName</strong> — @Model.EventDate.ToString("dd MMM yyyy") · @Model.Location
        </p>
    </div>
    <div>
        <a asp-controller="Organiser" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- LEFT: Add new category -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="bi bi-plus-circle"></i> Add Category</h6>
            </div>
            <div class="card-body">
                <form asp-controller="Organiser" asp-action="CreateCategory" method="post">
                    <input type="hidden" asp-for="NewCategory.EventID" value="@Model.EventID" />

                    <div class="mb-3">
                        <label asp-for="NewCategory.CategoryName" class="form-label">Category Name</label>
                        <input asp-for="NewCategory.CategoryName" class="form-control" placeholder="e.g., Senior, 10km" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewCategory.Distance" class="form-label">Distance (km)</label>
                        <input asp-for="NewCategory.Distance" type="number" step="0.01" class="form-control" placeholder="e.g., 10" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewCategory.AgeGroup" class="form-label">Age Group</label>
                        <input asp-for="NewCategory.AgeGroup" class="form-control" placeholder="e.g., 18-39" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewCategory.GenderGroup" class="form-label">Gender Group</label>
                        <select asp-for="NewCategory.GenderGroup" class="form-select">
                            <option value="">All</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="NewCategory.EntryFee" class="form-label">Entry Fee (R)</label>
                            <input asp-for="NewCategory.EntryFee" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="NewCategory.MaxParticipants" class="form-label">Max</label>
                            <input asp-for="NewCategory.MaxParticipants" type="number" class="form-control" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-raceday w-100">
                        <i class="bi bi-plus-circle"></i> Add Category
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- RIGHT: List existing categories -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="bi bi-list-ul"></i> Existing Categories (@Model.Categories.Count)</h6>
            </div>
            <div class="card-body p-0">
                @if (Model.Categories.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-tag text-muted" style="font-size:3rem;"></i>
                        <p class="mt-3 text-muted">No categories yet. Add your first category using the form.</p>
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Distance</th>
                                <th>Age / Gender</th>
                                <th>Fee</th>
                                <th>Enrolled</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model.Categories)
                            {
                                <tr>
                                    <td><strong>@cat.CategoryName</strong></td>
                                    <td>@cat.Distance km</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(cat.AgeGroup))
                                        {
                                            <span>@cat.AgeGroup</span>
                                        }
                                        @if (!string.IsNullOrEmpty(cat.GenderGroup))
                                        {
                                            <br />
                                
                                            <small class="text-muted">@cat.GenderGroup</small>
                                        }
                                    </td>
                                    <td>
                                        @if (cat.EntryFee.HasValue)
                                        {
                                            <span>R @cat.EntryFee.Value.ToString("F2")</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@cat.CurrentEnrolments / @(cat.MaxParticipants?.ToString() ?? "∞")</span>
                                    </td>
                                    <td class="text-end">
                                        <form asp-controller="Organiser" asp-action="DeleteCategory" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete category @cat.CategoryName? This cannot be undone.');">
                                            <input type="hidden" name="id" value="@cat.CategoryID" />
                                            <input type="hidden" name="eventId" value="@Model.EventID" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>